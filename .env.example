# Application
APP_NAME="Restaurant & Cafe Management System"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_USER=rcms_user
POSTGRES_PASSWORD=rcms_password
POSTGRES_DB=rcms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://rcms_user:rcms_password@db:5432/rcms_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
